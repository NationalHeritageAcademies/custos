{
  "name": "custos-db",
  "version": "0.1.1",
  "private": true,
  "description": "Custos — keeper of your queries. A lightweight, open-source desktop database client for Azure SQL, MySQL, and more.",
  "license": "MIT",
  "author": "Custos contributors",
  "homepage": "https://github.com/NationalHeritageAcademies/custos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NationalHeritageAcademies/custos.git"
  },
  "bugs": {
    "url": "https://github.com/NationalHeritageAcademies/custos/issues"
  },
  "keywords": [
    "database",
    "sql",
    "sql-client",
    "desktop",
    "electron",
    "angular",
    "mysql",
    "azure-sql",
    "mssql"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "main"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "clean": "tsc -b --clean",
    "rebuild": "npm run clean && npm run build",
    "app:renderer": "npm --prefix renderer run build",
    "app:start": "npm --workspace @custos/app run start",
    "app": "npm run build && npm run app:renderer && npm run app:start",
    "app:dev": "CUSTOS_DEV_SERVER_URL=http://localhost:4200 npm run app:start",
    "web": "npm run build && npm run app:renderer && node main/dist/server.js",
    "web:start": "node main/dist/server.js",
    "pack": "npm run build && npm run app:renderer",
    "dist": "npm run pack && electron-builder",
    "dist:mac": "npm run pack && electron-builder --mac",
    "dist:win:test": "npm run pack && SKIP_WIN_SIGN=1 electron-builder --win --publish never",
    "package:dist": "npm run pack && CUSTOS_NOTARIZE=1 electron-builder --mac --win --linux"
  },
  "dependencies": {
    "@custos/core": "*",
    "@custos/shared": "*",
    "@custos/driver-mysql": "*",
    "@custos/driver-azuresql": "*",
    "mysql2": "^3.11.3",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  }
}
