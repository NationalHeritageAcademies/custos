# Copy to .env.local for LOCAL signed builds. CI provides these as GitHub secrets.
# .env.local is git-ignored. Never commit real values.

# --- macOS notarization (Developer ID) ---
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX
# For the Developer ID signing cert, either import it into your login keychain,
# or point electron-builder at a .p12:
# CSC_LINK=base64-of-developer-id.p12
# CSC_KEY_PASSWORD=the-p12-password

# --- Windows Authenticode via Azure Trusted Signing (jsign) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
TRUSTED_SIGNING_ENDPOINT=https://eus.codesigning.azure.net
TRUSTED_SIGNING_ACCOUNT=
TRUSTED_SIGNING_PROFILE=
